# Пример секретов. Скопируйте в .streamlit/secrets.toml (локально)
# или вставьте содержимое в настройки приложения на Streamlit Cloud
# (Settings -> Secrets). Файл secrets.toml в репозиторий не коммитится.

# Пароль для вас: загрузка выгрузок, ввод звонков, настройки.
admin_password = "придумайте-длинный-пароль"

# Пароль для начальника: только просмотр дашборда.
viewer_password = "другой-пароль"

# Внешняя база. Обязательна при публикации в облаке: файловая система
# Streamlit Community Cloud очищается при каждом перезапуске приложения,
# и локальный SQLite вместе с ней. Локально строку можно не указывать.
# db_url = "postgresql+psycopg2://пользователь:пароль@хост:5432/имя_базы?sslmode=require"
